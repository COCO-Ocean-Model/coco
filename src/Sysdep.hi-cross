FC	= /usr/bin/xf90
FFLAGS	= mp(p(4),procnum(8),diag(2)),pvec(diag(1)),opt(o(ss)),list(s,p),langlvl(hf(77))
FOPTION = -W0,'$(FFLAGS)' -I$(OGCMDIR)/src/include $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE)
LINKOPT	= -parallel

AR	= /usr/bin/xar rs
RANLIB	= touch
RM	= rm -f

.F.o:
	$(FC) $(FOPTION) -c $<
