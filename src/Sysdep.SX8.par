FC      = sxmpif90
FFLAGS  = -Wf'-pvctl fullmsg noassume nodivloop noloopchg vr256 noverrchk novlchk -i noerrchk' -pi
FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/shared -I$(OGCMDIR)/src/depend.$(MODEL) -DOPT_PARALLEL -USX $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE)

AR      = sxar r
RANLIB  = touch
RM      = rm -f

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
