FC	= mpinfort

FFLAGS	= -O3 -fpp -finline-functions -finline-max-function-size=20 -finline-max-depth=1 -mno-vector-intrinsic-check -msched-insns -report-all -fdiag-vector=2 -fdiag-parallel=2 -fdiag-inline=2 -traceback=verbose -finline-file=$(OGCMDIR)/src/module/zocite.F90 -save

#FFLAGS	= -O3 -fpp -finline-functions -finline-max-function-size=20 -finline-max-depth=1 -mvector-intrinsic-check -msched-insns -report-all -fdiag-vector=2 -fdiag-parallel=2 -fdiag-inline=2 -traceback=verbose -minit-stack=nan

FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OPTIO) $(OPTEXMASK) $(OFFLINE) $(OPTOECO)

ifneq ($(filter -DOPT_IO_NCF,$(OPTIO)),)
	FFLAGS += -lnetcdff -lnetcdf -lpnetcdf -lhdf5_hl -lhdf5 -lsz -lz -lmpi
endif

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90

.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
