 FC = mpif90

 FFLAGS += -fast -O3 -Minfo=all -Mlre=noassoc -Mnopre -byteswapio -mcmodel=medium -DOPT_PARALLEL

ifeq "$(OMP)" ".omp"    
FFLAGS += -mp
endif

# debug
#FFLAGS +=                   -g
#FFLAGS +=                   -Mchkstk
 
 FOPTION = $(FFLAGS)                                  -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/touza -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OPTIO) $(OPTEXMASK) $(OPTTOUZA)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
