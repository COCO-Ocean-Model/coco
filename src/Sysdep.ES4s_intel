#module purge
#module load Intel_oneAPI/2021.1.1/all
#module load OpenMPI_intel/4.0.5
##FC	= mpiifort
FC      = mpifort
FFLAGS	= -O2 -convert big_endian -assume byterecl -fp-model precise -fpe0 -shared-intel -mcmodel=large -traceback
#FFLAGS	= -O2 -convert big_endian -assume byterecl -fp-model precise -fpe0 -shared-intel -mcmodel=large
#FFLAGS	= -g -u -CB -C -traceback -O2 -convert big_endian -fp-model precise -fpe0 -shared-intel -mcmodel=large

FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OFFLINE) $(OPTIO) $(OPTEXMASK) $(OPTOECO)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
