FC	= f90
FFLAGS	= mp(p(4),procnum(8),diag(2)),pvec(diag(1)),opt(o(ss),predicate(0),disbracket(0)),list(s,p),langlvl(hf(77))
FOPTION = -W0,'$(FFLAGS)' -I$(OGCMDIR)/src/include $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE)
LINKOPT	= -parallel

AR	= /usr/ccs/bin/ar r
RANLIB	= touch
RM	= rm -f

.F.o:
	$(FC) $(FOPTION) -c $<
