FC	= mpifort

FFLAGS = -cpp -fconvert=big-endian -O3 -ffree-line-length-none -fbacktrace -ffpe-trap=invalid,zero,overflow -mcmodel=large

FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/touza -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OPTIO) $(OPTEXMASK) $(OPTTOUZA)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
