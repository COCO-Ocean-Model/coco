FC	= ifort

# standard options for ICE @ JAMSTEC/YES
FFLAGS	= -u -w -xAVX -fpe0 -convert big_endian -lmpi

# debug options for Altix @ JAMSTEC/YES
#FFLAGS	= -check -u -w -traceback -g -fpe0 -O2 -fltconsistency -mtune=itanium2-p9000 -convert big_endian -lmpi
#FFLAGS  = -check -u -w -traceback -g -O0 -fpe0 -fltconsistency -convert big_endian -lmpi

FOPTION = $(FFLAGS) -Vaxlib -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OPTIO)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
