FC	= mpiifort
FFLAGS  = -fp-model precise -mcmodel=large -shared-intel -convert big_endian -fpe0 -traceback

# debug options
#FFLAGS  = -check all -init=arrays,snan,minus_huge -fp-model precise -mcmodel=large -shared-intel -convert big_endian -fpe0 -traceback


FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/touza -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OPTIO) $(OPTEXMASK) $(OPTTOUZA)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
