FC	= mpiifort

#FFLAGS	= -xCORE-AVX512 -convert big_endian -assume byterecl -fp-model precise -fpe0 -shared-intel -mcmodel=large
FFLAGS	= -g -u -CB -C -traceback -xCORE-AVX512 -convert big_endian -assume byterecl -fp-model precise -fpe0 -shared-intel -mcmodel=large
FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/touza -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OPTIO) $(OPTEXMASK) $(OPTTOUZA)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
