FC	= ifort

# standard options for ICE @ JAMSTEC/YES
FFLAGS	= -u -w -xAVX -fpe0 -convert big_endian -lmpi -DOPT_PARALLEL
#FFLAGS	= -u -w -O2 -fpe0 -fltconsistency -convert big_endian -lmpi -DOPT_PARALLEL
#FFLAGS	= -check -u -w -traceback -g -xAVX -fpe0 -convert big_endian -lmpi -DOPT_PARALLEL

# standard options for Altix @ JAMSTEC/YES
#FFLAGS	= -u -w -O2 -fpe0 -fltconsistency -mtune=itanium2-p9000 -convert big_endian -lmpi -DOPT_PARALLEL

# debug options for Altix @ JAMSTEC/YES
#FFLAGS	= -u -w -traceback -g -fpe0 -O2 -fltconsistency -mtune=itanium2-p9000 -convert big_endian -lmpi -DOPT_PARALLEL
#FFLAGS	= -check -u -w -traceback -g -fpe0 -O2 -fltconsistency -mtune=itanium2-p9000 -convert big_endian -lmpi -DOPT_PARALLEL

FOPTION = $(FFLAGS) -Vaxlib -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src -I$(OGCMDIR)/src/shared  -I$(OGCMDIR)/src/depend.$(MODEL) $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
