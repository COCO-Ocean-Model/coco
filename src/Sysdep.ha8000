FC	= /opt/mpich-mx/bin/mpif90
LINKOPT	= -parallel
RUNOPT = -F'PORT(ENDIANINOUT)'

FFLAGS	= -msg=w -Oss -autoinline -codemodel=medium  $(LINKOPT)
FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/build $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE) $(OPTIO)


AR	= /usr/bin/ar -r 
RANLIB	= /usr/bin/ranlib
RM	= rm -f

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
.F90.o:
	$(FC) $(FOPTION) -c $<
