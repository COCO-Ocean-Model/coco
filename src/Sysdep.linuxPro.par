FC	= mpif90
FFLAGS	= -O -N26 -YALL_NAMES=LCS -YEXT_SFX=_
LINKOPT = -lU77
FOPTION = $(FFLAGS) -I$(OGCMDIR)/src/include -I$(OGCMDIR)/src/module -I$(OGCMDIR)/src/shared  -I$(OGCMDIR)/src/depend.$(MODEL) -DOPT_PARALLEL $(OPTBDY) $(OPTSRST) $(OPTBBL) $(OPTTRIPOLE)

AR	= ar r
RANLIB	= ranlib
#RANLIB	= touch

.SUFFIXES: .F90
 
.F.o:
	$(FC) $(FOPTION) -c $<
	$(RM) $*.cpp
.F90.o:
	$(FC) $(FOPTION) -c $<
	$(RM) $*.cpp
